.claude

# Kbuild builds in place with M=$PWD, so its output lands here.
*.o
*.ko
*.mod
*.mod.c
*.d
*.rmeta
.*.cmd
modules.order
Module.symvers
.tmp_versions/

# Compiled test binaries. Allowlist rather than a name per test: everything in
# test/ is build output unless it is a source file or the Makefile, so adding a
# test needs no change here. Note `test/*`, not `test/`: git cannot re-include
# anything inside a directory it has been told to ignore wholesale.
test/*
!test/*.c
!test/*.h
!test/Makefile

# Cargo build output for the Rust binding.
rust/target/

# The cmake build tree.
/build/
