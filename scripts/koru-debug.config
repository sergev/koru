# Config fragment for the koru development kernel (Plan.md T0).
# Merged on top of a virtme-ng-generated VM config with:
#   scripts/kconfig/merge_config.sh -m .config ../koru-debug.config
#   make LLVM=1 olddefconfig
# Every option here must be re-checked in the resulting .config; merge_config.sh
# silently drops options whose dependencies are unmet.

# --- modules --------------------------------------------------------------
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y
# CONFIG_MODVERSIONS is not set
# CONFIG_MODULE_SIG is not set

# --- Rust -----------------------------------------------------------------
CONFIG_RUST=y
CONFIG_RUST_DEBUG_ASSERTIONS=y
CONFIG_RUST_OVERFLOW_CHECKS=y
CONFIG_SAMPLES=y
CONFIG_SAMPLES_RUST=y
CONFIG_SAMPLE_RUST_MINIMAL=m
CONFIG_SAMPLE_RUST_PRINT=m

# Rust is incompatible with these; make sure nothing turned them on.
# CONFIG_RANDSTRUCT is not set
CONFIG_RANDSTRUCT_NONE=y
# CONFIG_SHADOW_CALL_STACK is not set

# --- KASAN ----------------------------------------------------------------
CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y
CONFIG_KASAN_INLINE=y
CONFIG_KASAN_VMALLOC=y
CONFIG_KASAN_STACK=y

# --- lockdep --------------------------------------------------------------
CONFIG_DEBUG_KERNEL=y
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_DEBUG_SPINLOCK=y
CONFIG_DEBUG_MUTEXES=y
CONFIG_DEBUG_RWSEMS=y
CONFIG_DEBUG_LOCK_ALLOC=y

# --- kmemleak -------------------------------------------------------------
CONFIG_DEBUG_FS=y
CONFIG_DEBUG_KMEMLEAK=y
CONFIG_DEBUG_KMEMLEAK_AUTO_SCAN=y
CONFIG_DEBUG_KMEMLEAK_MEM_POOL_SIZE=32000

# --- misc debug that pays for itself in module work -----------------------
CONFIG_DEBUG_OBJECTS=y
CONFIG_DEBUG_OBJECTS_FREE=y
CONFIG_DEBUG_OBJECTS_TIMERS=y
CONFIG_DEBUG_OBJECTS_WORK=y
CONFIG_DEBUG_OBJECTS_RCU_HEAD=y
CONFIG_DEBUG_LIST=y
CONFIG_DEBUG_SG=y
CONFIG_DEBUG_VM=y
# DEBUG_STACKOVERFLOW and SCHED_DEBUG no longer exist as symbols in 7.1;
# they were removed upstream. Do not re-add them.

# --- symbols and unwinding ------------------------------------------------
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_GDB_SCRIPTS=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
# x86_64 uses the ORC unwinder, so FRAME_POINTER is not a symbol here.
# CONFIG_UNWINDER_ORC=y comes from the base config and gives reliable traces.
CONFIG_STACKTRACE=y
# KASAN inflates stack frames well past the default 1024/2048.
CONFIG_FRAME_WARN=4096

# BTF costs a pahole dependency and buys nothing here.
# CONFIG_DEBUG_INFO_BTF is not set
